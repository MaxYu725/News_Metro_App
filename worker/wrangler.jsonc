{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "news-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": [],
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metro_news_db",
      "database_id": "f8b597e9-8976-4f56-806e-51c9faa68a68",
      "migrations_dir": "migrations"
    },
    {
      "binding": "ARCHIVE_01",
      "database_name": "metro_news_archive_01",
      "database_id": "a3db6dc1-599c-4ace-b12c-142e56c3734a",
      "migrations_dir": "archive-migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "7252001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "FETCH_RATE_LIMITER",
      "namespace_id": "7252002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "7252003",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "API_KEY"
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
