{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "news-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": [],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metro_news_db",
      "database_id": "f8b597e9-8976-4f56-806e-51c9faa68a68",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "API_KEY"
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
